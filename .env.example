# LLM Configuration
MODEL=ollama/qwen3.5:27b
# For Mistral, swap to: MODEL=ollama/mistral-small:24b
OLLAMA_BASE_URL=http://localhost:11434

# Authentication
# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-generate-a-real-secret!!
# Invite code — only people who know this can register an account
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
INVITE_CODE=change-me-pick-a-code

# API Keys
SERPER_API_KEY=your_serper_api_key_here

# Image Generation
# Backend: "zimage" (Z-Image-Turbo), "sd" (Stable Diffusion v1.5), or "none"
IMAGE_BACKEND=zimage
# ZImage settings
ZIMAGE_MODEL=mrfakename/Z-Image-Turbo
ZIMAGE_WIDTH=512
ZIMAGE_HEIGHT=512
# Stable Diffusion settings
# SD_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
# HuggingFace token (for gated model downloads; optional after first download)
# HUGGINGFACE_TOKEN=hf_your_token_here
# Set to 1 after first model download for fully offline operation
TRANSFORMERS_OFFLINE=0

# OCR for scanned PDFs
# Pages with no text layer are rendered to PNG and sent to an Ollama VISION
# model. Ollama models cannot ingest a PDF directly — only images — so the app
# does the rendering and downscaling itself.
# OCR_ENABLED=1
# deepseek-ocr:3b is the recommended default: ~3s/page and far more complete
# than qwen3-vl:8b on the same scan. It needs its own prompt format, which
# ingestion.py selects automatically from the model name.
# OCR_MODEL=deepseek-ocr:3b
# Render resolution before downscaling.
# OCR_DPI=150
# Longest edge sent to the model. Do NOT raise this casually: qwen3-vl returns
# an EMPTY string when the image is much over 1024px.
# OCR_MAX_DIM=1024
# Safety caps for large documents.
# OCR_MAX_PAGES=20
# OCR_TIMEOUT=180
# When an upload had to be OCR'd, the browser immediately downloads the
# transcription as a document. Set to "none" to keep it click-to-download from
# the Files panel instead. Only applies to scans/photos — a PDF that already has
# a text layer never triggers it.
# OCR_AUTO_EXPORT=docx        # docx | odt | none

# Speech-to-text (faster-whisper / CTranslate2)
# Model size: tiny | base | small | medium | large-v3. "small" is the accuracy/
# speed sweet spot for short mic clips and is the default.
# WHISPER_MODEL=small
# Device: cpu (default) or cuda. CPU keeps STT off the GPU, which is already
# shared between Ollama and the image pipelines.
# WHISPER_DEVICE=cpu
# Quantisation: int8 on CPU, float16 on cuda. Defaults follow WHISPER_DEVICE.
# WHISPER_COMPUTE_TYPE=int8
# Silero VAD strips silence before decoding — this is what stops Whisper
# inventing text ("Thank you for watching.") on near-silent recordings.
# Set to 0 if it clips genuinely quiet speech.
# WHISPER_VAD=1

# Image quality — critique-and-retry loop
# A diffusion model renders once and never looks at the result. This loop asks a
# vision model whether the image matches the request, rewrites the prompt if not,
# and re-renders. It is most of what makes agentic image systems better than a
# bare pipeline. Each extra round costs another generation plus an Ollama
# unload/reload, so images take roughly 2-3x longer. Set to 0 to disable.
# IMAGE_REFINE_ROUNDS=2
# Must be a vision-capable Ollama model.
# IMAGE_CRITIC_MODEL=qwen3-vl:8b
# Pin to a positive integer for reproducible images. Left at 0 each render uses
# a fresh seed, which is what lets a refine retry produce a different result.
# IMAGE_SEED=0

# Video generation
# Backend: ltx | wan | none.
#   ltx  — LTX-Video, fast; NVIDIA's guidance names a 16GB card for it
#   wan  — Wan 2.1 T2V 1.3B, Apache-2.0, smallest VRAM footprint
# Weights are several GB and are NOT downloaded during a chat request; fetch once
# with `hf download <model>` first, or the tool returns instructions.
# VIDEO_BACKEND=ltx
# LTX_MODEL=Lightricks/LTX-Video
# WAN_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# VIDEO_WIDTH=704
# VIDEO_HEIGHT=512
# VIDEO_FPS=25
# VIDEO_SECONDS=2.5
# VIDEO_STEPS=50
# VIDEO_GUIDANCE=3.0

# Tutor spaced repetition
# Scheduler: "fsrs" (default) models difficulty, stability and retrievability per
# card and needs ~20-30% fewer reviews than SM-2 for the same retention.
# Set to "sm2" to fall back to the pre-2.6 algorithm.
# SRS_ALGO=fsrs
# Target probability of recall at review time. Lower = fewer, longer-spaced
# reviews; higher = more frequent. 0.9 is the FSRS default.
# SRS_DESIRED_RETENTION=0.9
# Ceiling on any review interval, in days. FSRS defaults to 36500, which is
# meaningless for language study.
# SRS_MAX_INTERVAL=365
# Only used when SRS_ALGO=sm2.
# SRS_INITIAL_EASE=2.5

# ── Model / crew tuning ──────────────────────────────────────────────
# Fallback model used for the planning phase when the main model lacks
# tool-calling support (needs {{.Tools}} in its Ollama template).
# PLANNING_MODEL=ollama/qwen3.5:9b
# Server-wide ceiling on a crew run, in seconds. The per-user "Request Timeout"
# slider in the params panel overrides this.
# CREW_TIMEOUT_SEC=180
# CrewAI agent executor: "classic" (default) is the one all the compatibility
# patches in patches.py target. "experimental" opts into CrewAI's newer
# Flow-based executor, on which the P3 context-length patch does NOT apply.
# CREWAI_EXECUTOR=classic
# How long a login token stays valid.
# JWT_EXPIRE_HOURS=72

# ── HuggingFace access ───────────────────────────────────────────────
# Model downloads are rate-limited when unauthenticated, which is slow for the
# multi-GB image and video weights. The `hf` CLI reads HF_TOKEN specifically
# (not HUGGINGFACE_TOKEN); `hf auth login` stores it permanently instead.
# HF_TOKEN=
# Set to 1 to forbid any network access to the Hub — everything must be cached.
# HF_HUB_OFFLINE=0

# ── Image pipeline internals ─────────────────────────────────────────
# Warm the image backend at startup so the first request is not slow.
# IMAGE_WARMUP=1
# Allow the startup warm-up to download missing weights.
# IMAGE_WARMUP_FORCE_ONLINE=1
# Endpoint used ONLY to unload/reload Ollama around GPU work, never for images.
# OLLAMA_IMAGE_URL=http://localhost:11434/api/generate
# Real-ESRGAN upscaling pass after generation.
# IMAGE_REALESRGAN=0

# ZImage (Z-Image-Turbo) — a turbo model, hence very few steps and no guidance.
# ZIMAGE_STEPS=4
# ZIMAGE_GUIDANCE=0.0
# ZIMAGE_MAX_SEQ=512
# Hi-res mode: generate a base image then upscale in tiles with img2img refine.
# ZIMAGE_HIRES=0
# ZIMAGE_HIRES_WIDTH=2048
# ZIMAGE_HIRES_HEIGHT=2048
# Overlap between tiles, in pixels — larger hides seams better but costs time.
# ZIMAGE_TILE_OVERLAP=192
# How much each refine pass may change the tile. Too high hallucinates detail,
# too low leaves it blurry.
# ZIMAGE_HIRES_STRENGTH=0.35

# ERNIE-Image
# ERNIE_GGUF_VARIANT=Q4_K_M
# ERNIE_STEPS=20

# FLUX.1-schnell — guidance-distilled, so it needs very few steps.
# FLUX_MODEL=black-forest-labs/FLUX.1-schnell
# FLUX_STEPS=4

# Applied to every video generation to suppress common artefacts.
# VIDEO_NEGATIVE_PROMPT=blurry, distorted, low quality, watermark, text

# OpenAI-compatible /v1 proxy (ollama launch / Open WebUI / Continue.dev / etc.)
# External tools: set OPENAI_BASE_URL=http://localhost:8000/v1
# Leave empty to allow any client without a key (Ollama default behaviour).
# Set to a secret value to require Bearer token auth: Authorization: Bearer <key>
# PROXY_API_KEY=
